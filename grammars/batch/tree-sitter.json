{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "batch",
      "camelcase": "Batch",
      "title": "Batch",
      "scope": "source.batch",
      "file-types": [
        "bat",
        "cmd"
      ],
      "injection-regex": "^batch$",
      "class-name": "TreeSitterBatch"
    }
  ],
  "metadata": {
    "version": "0.0.0",
    "license": "MIT",
    "description": "Windows Batch grammar",
    "authors": [
      {
        "name": "Sekaus",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/Sekaus/tree-sitter-batch-zed",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}